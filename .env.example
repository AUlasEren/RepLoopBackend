# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real secrets.

# Resend SMTP API key — generate from https://resend.com/api-keys
SMTP_PASSWORD=re_your_resend_api_key_here

# Ollama models for recommender service
# Hem recommend hem discover endpoint'i fine-tune'u kullanir.
# Rollback: bu degerleri "llama3.2:3b" yap (pre-fine-tune base model).
OLLAMA_RECOMMEND_MODEL=reploop-fitness
OLLAMA_DISCOVER_MODEL=reploop-fitness
